# ContractIQ Production Environment Configuration
APP_ENV=production
DEBUG=false
SECRET_KEY=replace-with-a-cryptographically-strong-random-key-32chars

# PostgreSQL (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=inventory_risk_db

# Local Dev Override (SQLite default when not using Docker)
# DATABASE_URL=sqlite:///./inventory_risk.db

# Vector DB (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=supplier_documents

# Local ONNX Embedding Model
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# LLM Provider (Groq Llama 3.3 70B — optional; grounded fallback works offline)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# CORS & Frontend Networking
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
AUTO_SEED=true
UVICORN_WORKERS=1
